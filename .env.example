# Required application secret (generate a long random value)
SESSION_SECRET=replace-with-at-least-32-random-characters

# app.py / Uvicorn starts one embedded supervisor automatically; four concurrent lecture jobs, one per GPU.
JOB_CONCURRENCY=4
JOB_GPU_IDS=0,1,2,3
JOB_POLL_SECONDS=2
JOB_HEARTBEAT_SECONDS=10
JOB_LEASE_SECONDS=60
JOB_TIMEOUT_SECONDS=7200
JOB_MAX_ATTEMPTS=3
JOB_RETRY_SECONDS=10

# Do not set DITTO_GPU when JOB_GPU_IDS is used. The embedded supervisor pins each runner.
# DITTO_GPU=

# Default lecture format used by /lectures/new and AI Instructor.
LECTURE_TARGET_DURATION_MINUTES=40
LECTURE_TARGET_SLIDE_COUNT=10

# Avatar background/chroma pipeline
AVATAR_INPUT_MODE=auto
AVATAR_CHROMA_COLOR=auto
AVATAR_CHROMA_SIMILARITY=0.12
AVATAR_CHROMA_BLEND=0.06
BACKGROUND_REMOVAL_REQUIRED=true
REMBG_MODEL=u2net_human_seg

# Security hardening (comma-separated hostnames; leave empty in local development)
TRUSTED_HOSTS=

# Slide rendering: when false, slides are composed locally; when true,
# full-slide Image API rendering is used only if the user enables image generation.
LECTURE_RENDER_SLIDES_WITH_IMAGE_MODEL=true
OPENAI_SLIDE_IMAGE_QUALITY=high

# Unreferenced retry/run directories are deleted after this retention window.
LECTURE_ORPHAN_RUN_RETENTION_HOURS=24

# User features NEVER fall back to system OPENAI_API_KEY / MOODLE_URL / MOODLE_TOKEN.
# Each user must register their own credentials under API / 연결 설정.
