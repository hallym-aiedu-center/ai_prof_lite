# Required application secret (generate a long random value)
SESSION_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_MASTER_KEY=replace-with-generated-fernet-key

# Optional shared signup gate. Leave empty to allow normal registration.
REGISTRATION_CODE=

# OpenAI credential policy: user = BYOK per account, server = shared server key.
OPENAI_KEY_MODE=user
SERVER_OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=120

# app.py / Uvicorn starts one embedded supervisor automatically; four concurrent lecture jobs, one per GPU.
JOB_CONCURRENCY=4
MAX_RUNNING_JOBS_PER_USER=1
JOB_GPU_IDS=0,1,2,3
JOB_POLL_SECONDS=2
JOB_HEARTBEAT_SECONDS=10
JOB_LEASE_SECONDS=60
JOB_TIMEOUT_SECONDS=7200
JOB_MAX_ATTEMPTS=3
JOB_RETRY_SECONDS=10

# Do not set DITTO_GPU when JOB_GPU_IDS is used. The embedded supervisor pins each runner.
# DITTO_GPU=

# Default lecture format used by /lectures/new and AI Instructor.
LECTURE_TARGET_DURATION_MINUTES=40
LECTURE_TARGET_SLIDE_COUNT=10
# Generate with 5% narration headroom, then measure actual TTS duration.
LECTURE_DURATION_GENERATION_RATIO=1.05
# Maximum LLM narration-expansion passes when measured TTS is still too short.
LECTURE_DURATION_MAX_RETRIES=3

# Optional reference material limits. Small files are sent as full extracted text;
# large material is reduced to topic-relevant excerpts before lecture generation.
MAX_REFERENCE_FILES=5
MAX_REFERENCE_FILE_BYTES=10485760
MAX_REFERENCE_UPLOAD_BYTES=26214400
MAX_REFERENCE_CONTEXT_CHARS=120000

# Per-lecture cost estimate used for the user-set admission budget.
# These are planning coefficients, not provider billing records.
LECTURE_EST_TEXT_BASE_USD=0.35
LECTURE_EST_IMAGE_PER_SLIDE_USD=0.12
LECTURE_EST_TTS_PER_MINUTE_USD=0.03
LECTURE_EST_RETRY_BUFFER_RATIO=0.20

# Avatar background/chroma pipeline
AVATAR_INPUT_MODE=auto
AVATAR_CHROMA_COLOR=auto
AVATAR_CHROMA_SIMILARITY=0.12
AVATAR_CHROMA_BLEND=0.06
BACKGROUND_REMOVAL_REQUIRED=true
REMBG_MODEL=u2net_human_seg

# Security hardening (comma-separated hostnames; leave empty in local development)
TRUSTED_HOSTS=

# Slide rendering: when false, slides are composed locally; when true,
# full-slide Image API rendering is used only if the user enables image generation.
LECTURE_RENDER_SLIDES_WITH_IMAGE_MODEL=true
OPENAI_SLIDE_IMAGE_QUALITY=high

# Unreferenced retry/run directories are deleted after this retention window.
LECTURE_ORPHAN_RUN_RETENTION_HOURS=24

# Moodle credentials are always user-owned. OpenAI follows OPENAI_KEY_MODE.
# In user mode each account must register its own OpenAI key under API / 연결 설정.
# In server mode SERVER_OPENAI_API_KEY is shared by lecture jobs; the UI hides personal OpenAI key input.

# AI Instructor recovery window after server downtime. Set 0 to disable catch-up.
AI_INSTRUCTOR_CATCHUP_GRACE_MINUTES=120

# Ditto installation paths (project-relative paths are supported).
DITTO_ROOT=core/ditto-talkinghead
DITTO_DATA_ROOT=core/ditto-talkinghead/checkpoints/ditto_trt_Ampere_Plus
DITTO_CFG_PKL=core/ditto-talkinghead/checkpoints/ditto_cfg/v0.4_hubert_cfg_trt.pkl
# DITTO_PYTHON=/absolute/path/to/ditto/python
